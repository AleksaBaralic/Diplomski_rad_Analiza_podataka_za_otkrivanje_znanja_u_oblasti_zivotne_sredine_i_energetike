  <DataSets>
    <DataSet Name="PopulacijaDataset">
      <Query>
        <DataSourceName>CO2_DS2</DataSourceName>
        <CommandText>SELECT
{[Measures].[Cumulative Emission Tons]} ON COLUMNS,
TOPCOUNT(EXCEPT([Dim Country].[Country Key].MEMBERS, {[Dim Country].[Country Key].[All]}), 15, [Measures].[Cumulative Emission Tons]) ON ROWS
FROM [CO2_Cube]
WHERE ([Dim Year].[Decade].&amp;[2020])</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
