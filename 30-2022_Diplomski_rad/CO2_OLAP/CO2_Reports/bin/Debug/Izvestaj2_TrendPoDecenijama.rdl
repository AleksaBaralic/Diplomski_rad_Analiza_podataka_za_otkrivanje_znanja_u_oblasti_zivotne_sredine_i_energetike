  <DataSets>
    <DataSet Name="TrendDataset">
      <Query>
        <DataSourceName>CO2_DS2</DataSourceName>
        <CommandText>SELECT
{[Measures].[Annual Emission Tons]} ON COLUMNS,
[Dim Year].[Decade].[Decade].MEMBERS ON ROWS
FROM [CO2_Cube]</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
            <CommandType>MDX</CommandType>
            <Type>Query</Type>
            <QuerySpecification xsi:type="MDXQuerySpecification">
              <Select>
                <Items>
                  <Item>
                    <ID xsi:type="Level">
                      <DimensionName>Dim Year</DimensionName>
                      <HierarchyName>Decade</HierarchyName>
                      <HierarchyUniqueName>[Dim Year].[Decade]</HierarchyUniqueName>
                      <LevelName>Decade</LevelName>
                      <UniqueName>[Dim Year].[Decade].[Decade]</UniqueName>
                    </ID>
                    <ItemCaption>Decade</ItemCaption>
                  </Item>
                  <Item>
                    <ID xsi:type="Measure">
                      <MeasureName>Annual Emission Tons</MeasureName>
                      <UniqueName>[Measures].[Annual Emission Tons]</UniqueName>
                    </ID>
                    <ItemCaption>Annual Emission Tons</ItemCaption>
                    <FormattedValue>true</FormattedValue>
                  </Item>
                </Items>
              </Select>
              <AutoExecute>false</AutoExecute>
              <From>CO2_Cube</From>
              <Filter>
                <FilterItems />
              </Filter>
              <Calculations />
              <Aggregates />
              <QueryProperties />
            </QuerySpecification>
            <Query>
              <Statement>SELECT
{[Measures].[Annual Emission Tons]} ON COLUMNS,
[Dim Year].[Decade].[Decade].MEMBERS ON ROWS
FROM [CO2_Cube]</Statement>
              <ParameterDefinitions />
            </Query>
          </QueryDefinition>
        </rd:DesignerState>
      </Query>
      <Fields>
        <Field Name="Decade">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Dim Year].[Decade].[Decade]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Annual_Emission_Tons">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Annual Emission Tons]" /&gt;</DataField>
